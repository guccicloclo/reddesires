# Copiez ce fichier en ".env" et remplissez les valeurs (ne jamais committer .env)

# Nom affiché de la boutique
VITE_SHOP_NAME="Maison Velours"

# Firebase (Console Firebase > Paramètres du projet > Vos applications > Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Compte admin unique (créé dans Firebase Authentication > Email/Mot de passe)
# Utilisé par le script de seed ET par les règles Firestore (voir README)
VITE_ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Stripe : lien de paiement en MODE TEST (https://buy.stripe.com/test_...)
VITE_STRIPE_PAYMENT_LINK=
