rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin unique : REMPLACEZ l'adresse par celle de votre compte Firebase Auth
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@example.com';
    }

    // Produits : lecture publique, écriture réservée à l'admin
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Commandes (démo, sans compte client)
    match /orders/{id} {
      // Création publique, limitée aux champs nécessaires à une commande de démonstration.
      allow create: if request.resource.data.keys().hasOnly([
          'customerName', 'items', 'total', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'customerName', 'items', 'total', 'status', 'createdAt'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.total <= 100000
        && request.resource.data.status == 'en attente'
        && request.resource.data.createdAt == request.time;
      // Seul l'admin peut consulter, modifier ou supprimer une commande.
      // Sans webhook, un retour navigateur ne constitue pas une preuve de paiement.
      allow update, read, delete: if isAdmin();
    }
  }
}
